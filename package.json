{
  "name": "nearbridge",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A local, personal bridge between Windows and HarmonyOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZJUZhiyuCai/NearBridge.git"
  },
  "bugs": {
    "url": "https://github.com/ZJUZhiyuCai/NearBridge/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:active": "node scripts/benchmark-active.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "start:windows": "node scripts/start-windows.mjs",
    "install:windows": "node scripts/install-windows.mjs",
    "build:phone": "node scripts/build-harmony.mjs",
    "phone:tools": "node scripts/deveco-harmony.mjs",
    "phone:login": "node scripts/deveco-harmony.mjs auth login",
    "phone:sign": "node scripts/deveco-harmony.mjs signature generate --product default",
    "install:mac": "node scripts/install-mac.mjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "qrcode": "1.5.4"
  }
}
