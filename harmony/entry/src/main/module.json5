{
  "module": {
    "name": "entry", "type": "entry", "mainElement": "EntryAbility",
    "deviceTypes": ["phone"], "deliveryWithInstall": true, "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [{ "name": "ohos.permission.INTERNET" }, { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.ACCESS_BLUETOOTH", "reason": "$string:bluetooth_reason", "usedScene": { "abilities": ["EntryAbility", "ShareAbility"], "when": "inuse" } }],
    "abilities": [{
      "name": "EntryAbility", "srcEntry": "./ets/entryability/EntryAbility.ets",
      "label": "$string:app_name", "icon": "$media:app_icon",
      "startWindowIcon": "$media:app_icon", "startWindowBackground": "$color:start_background",
      "exported": true,
      "skills": [{ "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] }]
    }],
    "extensionAbilities": [{
      "name": "ShareAbility", "srcEntry": "./ets/shareability/ShareAbility.ets",
      "type": "share", "exported": true,
      "label": "$string:share_label", "icon": "$media:app_icon",
      "skills": [{
        "actions": ["ohos.want.action.sendData"],
        "uris": [
          { "scheme": "file", "utd": "general.file", "maxFileSupported": 50 },
          { "scheme": "file", "utd": "general.image", "maxFileSupported": 50 },
          { "scheme": "file", "utd": "general.video", "maxFileSupported": 50 },
          { "scheme": "file", "utd": "general.audio", "maxFileSupported": 50 },
          { "scheme": "file", "utd": "general.archive", "maxFileSupported": 50 },
          { "scheme": "file", "utd": "general.composite-object", "maxFileSupported": 50 },
          { "scheme": "file", "utd": "general.text", "maxFileSupported": 50 }
        ]
      }]
    }]
  }
}
